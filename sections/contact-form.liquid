{% liquid
  assign page_heading = page.title | default: section.settings.breadcrumb_label | default: 'Contact Us'
  assign customer_first_name = customer.first_name | default: ''
  assign customer_last_name = customer.last_name | default: ''
  assign customer_email = customer.email | default: ''
  assign customer_phone = customer.phone | default: ''
%}

<!-- Contact Us Page Section -->
<section class="creative-contact-section">
  <div class="container">
    
    <!-- Top Breadcrumbs -->
    <nav class="contact-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ section.settings.home_label | default: 'Home' | escape }}</a>
      <i class="fa-solid fa-chevron-right"></i>
      <span>{{ page_heading | escape }}</span>
    </nav>

    <!-- Header Card -->
    <header class="contact-hero-card">
      <div class="contact-hero-content">
        <span class="contact-badge-pill">
          <i class="fa-solid fa-headset text-success"></i>
          <span>GET IN TOUCH</span>
        </span>
        <h1 class="contact-main-title">{{ section.settings.form_heading | default: 'We Are Here To Help You' }}</h1>
        <p class="contact-hero-desc">
          Have questions about our smart gadgets, order tracking, or return policies? Send us a message and our expert support team will respond within 2 hours.
        </p>
      </div>
    </header>

    {% if section.settings.map_embed_url != blank %}
      <div class="map-card-wrapper">
        <iframe
          src="{{ section.settings.map_embed_url | escape }}"
          title="{{ section.settings.map_label | default: 'Store Location' | escape }}"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          class="contact-map-iframe"
        ></iframe>
      </div>
    {% endif %}

    <div class="row contact-grid-row">
      
      <!-- Left Column: Contact Form Card -->
      <div class="col-md-7 col-lg-8">
        <div class="contact-form-card">
          <h2 class="form-title">Send Us A Message</h2>
          <p class="form-subtitle">Fill in the details below and we'll get back to you shortly.</p>

          {% form 'contact', id: 'contact_form', class: 'shopify-contact-form' %}
            {% if form.posted_successfully? %}
              <div class="contact-alert alert-success">
                <i class="fa-solid fa-circle-check text-success"></i>
                <span>{{ section.settings.success_message | default: 'Thank you! Your message has been sent successfully.' }}</span>
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="contact-alert alert-danger">
                <i class="fa-solid fa-circle-exclamation text-danger"></i>
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            <div class="row">
              <div class="col-sm-6">
                <div class="form-group-item">
                  <label for="ContactFirstName-{{ section.id }}" class="form-label-text">
                    {{ section.settings.first_name_label | default: 'First Name' }}
                  </label>
                  <input
                    id="ContactFirstName-{{ section.id }}"
                    class="form-input-field"
                    type="text"
                    name="contact[first_name]"
                    value="{{ form.first_name | default: customer_first_name | escape }}"
                    placeholder="John"
                    autocomplete="given-name"
                  >
                </div>
              </div>

              <div class="col-sm-6">
                <div class="form-group-item">
                  <label for="ContactLastName-{{ section.id }}" class="form-label-text">
                    {{ section.settings.last_name_label | default: 'Last Name' }}
                  </label>
                  <input
                    id="ContactLastName-{{ section.id }}"
                    class="form-input-field"
                    type="text"
                    name="contact[last_name]"
                    value="{{ form.last_name | default: customer_last_name | escape }}"
                    placeholder="Doe"
                    autocomplete="family-name"
                  >
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-sm-6">
                <div class="form-group-item">
                  <label for="ContactEmail-{{ section.id }}" class="form-label-text">
                    {{ section.settings.email_label | default: 'Email Address *' }}
                  </label>
                  <input
                    id="ContactEmail-{{ section.id }}"
                    class="form-input-field"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email | default: customer_email | escape }}"
                    placeholder="john.doe@example.com"
                    autocomplete="email"
                    required
                  >
                </div>
              </div>

              <div class="col-sm-6">
                <div class="form-group-item">
                  <label for="ContactPhone-{{ section.id }}" class="form-label-text">
                    {{ section.settings.phone_label | default: 'Phone Number' }}
                  </label>
                  <input
                    id="ContactPhone-{{ section.id }}"
                    class="form-input-field"
                    type="tel"
                    name="contact[phone]"
                    value="{{ form.phone | default: customer_phone | escape }}"
                    placeholder="+1 (800) 555-0199"
                    autocomplete="tel"
                  >
                </div>
              </div>
            </div>

            <div class="form-group-item">
              <label for="ContactBody-{{ section.id }}" class="form-label-text">
                {{ section.settings.message_label | default: 'Your Message *' }}
              </label>
              <textarea
                id="ContactBody-{{ section.id }}"
                class="form-textarea-field"
                name="contact[body]"
                rows="5"
                placeholder="How can we help you today?"
                required
              >{{ form.body }}</textarea>
            </div>

            <button type="submit" class="contact-submit-btn">
              <span>{{ section.settings.button_label | default: 'Send Message' }}</span>
              <i class="fa-solid fa-paper-plane"></i>
            </button>
          {% endform %}
        </div>
      </div>

      <!-- Right Column: Contact Info Sidebar -->
      <div class="col-md-5 col-lg-4">
        <div class="contact-info-card">
          <h3 class="info-card-title">{{ section.settings.info_title | default: 'Contact Information' }}</h3>
          <p class="info-card-subtitle">{{ section.settings.info_text | default: 'Reach out to our team directly through phone, email, or physical store.' }}</p>

          <div class="info-divider"></div>

          <div class="info-items-list">
            
            {% if section.settings.address != blank %}
              <div class="info-item-row">
                <div class="info-icon-box">
                  <i class="fa-solid fa-location-dot text-danger"></i>
                </div>
                <div class="info-text-box">
                  <h4 class="info-item-heading">{{ section.settings.address_heading | default: 'Address' }}</h4>
                  <p class="info-item-value">{{ section.settings.address | newline_to_br }}</p>
                </div>
              </div>
            {% endif %}

            {% if section.settings.phone_primary != blank or section.settings.phone_secondary != blank %}
              <div class="info-item-row">
                <div class="info-icon-box">
                  <i class="fa-solid fa-phone text-success"></i>
                </div>
                <div class="info-text-box">
                  <h4 class="info-item-heading">{{ section.settings.phone_heading | default: 'Call Us' }}</h4>
                  {% if section.settings.phone_primary != blank %}
                    <p class="info-item-value">{{ section.settings.phone_primary }}</p>
                  {% endif %}
                  {% if section.settings.phone_secondary != blank %}
                    <p class="info-item-value">{{ section.settings.phone_secondary }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            {% if section.settings.email_primary != blank or section.settings.email_secondary != blank %}
              <div class="info-item-row">
                <div class="info-icon-box">
                  <i class="fa-solid fa-envelope text-info"></i>
                </div>
                <div class="info-text-box">
                  <h4 class="info-item-heading">{{ section.settings.email_heading | default: 'Email Us' }}</h4>
                  {% if section.settings.email_primary != blank %}
                    <p class="info-item-value">{{ section.settings.email_primary }}</p>
                  {% endif %}
                  {% if section.settings.email_secondary != blank %}
                    <p class="info-item-value">{{ section.settings.email_secondary }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            <div class="info-item-row">
              <div class="info-icon-box">
                <i class="fa-solid fa-clock text-warning"></i>
              </div>
              <div class="info-text-box">
                <h4 class="info-item-heading">Support Hours</h4>
                <p class="info-item-value">Mon - Fri: 9:00 AM - 6:00 PM EST</p>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% stylesheet %}
  .creative-contact-section {
    padding: 36px 0 64px 0;
    background: #f8fafc;
  }

  .creative-contact-section .container {
    width: 100% !important;
    max-width: 1240px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 15px !important;
    padding-right: 15px !important;
  }

  /* Breadcrumbs */
  .contact-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #64748b;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .contact-breadcrumbs a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-breadcrumbs a:hover {
    color: #10b981;
  }

  .contact-breadcrumbs i {
    font-size: 10px;
    color: #cbd5e1;
  }

  .contact-breadcrumbs span {
    color: #0f172a;
    font-weight: 700;
  }

  /* Hero Card */
  .contact-hero-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    padding: 32px 36px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    margin-bottom: 28px;
  }

  .contact-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #10b981;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .contact-main-title {
    font-size: 32px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 10px;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .contact-hero-desc {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    max-width: 760px;
  }

  /* Map Card */
  .map-card-wrapper {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    margin-bottom: 32px;
    height: 360px;
  }

  .contact-map-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Form Card */
  .contact-form-card,
  .contact-info-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
  }

  .form-title,
  .info-card-title {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 6px;
  }

  .form-subtitle,
  .info-card-subtitle {
    font-size: 13px;
    color: #64748b;
    margin-bottom: 24px;
  }

  .form-group-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
  }

  .form-label-text {
    font-size: 12px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .form-input-field,
  .form-textarea-field {
    width: 100%;
    border-radius: 12px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    padding: 12px 16px;
    font-size: 14px;
    color: #0f172a;
    outline: none;
    transition: all 0.2s ease;
  }

  .form-input-field:focus,
  .form-textarea-field:focus {
    border-color: #10b981;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
  }

  .contact-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    padding: 12px 32px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 800;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
  }

  .contact-submit-btn:hover {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
  }

  .contact-alert {
    padding: 14px 18px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .alert-success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .alert-danger {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  /* Info Card Sidebar */
  .info-divider {
    height: 1px;
    background: #f1f5f9;
    margin-bottom: 24px;
  }

  .info-items-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-item-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .info-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .info-text-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .info-item-heading {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }

  .info-item-value {
    font-size: 13px;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 991px) {
    .contact-info-card {
      margin-top: 24px;
    }
  }

  @media (max-width: 575px) {
    .contact-hero-card,
    .contact-form-card,
    .contact-info-card {
      padding: 24px;
    }

    .contact-main-title {
      font-size: 24px;
    }

    .contact-submit-btn {
      width: 100%;
    }
  }
{% endstylesheet %}

