{%- liquid
  assign showcase_collection = section.settings.collection
  assign featured_product = section.settings.featured_product
  assign featured_block = blank
  assign has_manual_products = false

  if section.blocks.size > 0
    for block in section.blocks
      if block.type == 'featured_panel' and featured_block == blank
        assign featured_block = block
      elsif block.type == 'manual_product'
        assign has_manual_products = true
      endif
    endfor
  endif

  if featured_block != blank and featured_block.settings.product != blank
    assign featured_product = featured_block.settings.product
  endif

  if featured_product == blank and showcase_collection != blank and showcase_collection.products_count > 0
    assign featured_product = showcase_collection.products.first
  endif

  assign featured_variant = blank
  assign is_featured_available = true

  if featured_product != blank
    assign featured_variant = featured_product.selected_or_first_available_variant | default: featured_product.variants.first
    if featured_product.available == false
      assign is_featured_available = false
    elsif featured_variant != blank and featured_variant.available == false
      assign is_featured_available = false
    endif
  endif
-%}

<!-- Top Selling Showcase Section -->
<section class="creative-top-selling">
  <div class="container">
    
    <div class="top-selling-head">
      <div class="section-title-box">
        <span class="section-badge-pill">
          <i class="fa-solid fa-crown text-warning"></i>
          <span>WEEKLY BESTSELLERS</span>
        </span>
        <h2 class="section-main-heading">{{ section.settings.heading | default: 'Top Selling of the Week' }}</h2>
      </div>
    </div>

    <div class="row top-selling-grid-row">
      
      <!-- Left Column: Top Selling Product Grid -->
      <div class="col-md-6">
        <div class="top-selling-products-grid">
          {% if has_manual_products %}
            {%- liquid
              assign manual_count = 0
            -%}
            {% for block in section.blocks %}
              {% if block.type != 'manual_product' %}
                {% continue %}
              {% endif %}
              {% if block.settings.product != blank %}
                {% render 'product-card', block: block, product: block.settings.product %}
              {% else %}
                {% render 'product-card', block: block, fallback_image: block.settings.fallback_image, fallback_tag: block.settings.fallback_tag, fallback_title: block.settings.fallback_title, fallback_price: block.settings.fallback_price, fallback_compare_price: block.settings.fallback_compare_price %}
              {% endif %}
              {%- liquid
                assign manual_count = manual_count | plus: 1
              -%}
              {% if manual_count >= section.settings.products_limit %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% if manual_count == 0 %}
              {% render 'product-card', fallback_image: 'item-img-1-6.jpg', fallback_tag: 'Audio', fallback_title: 'Noise Cancelling Wireless Headphones', fallback_price: '$149.00', fallback_compare_price: '$199.00' %}
              {% render 'product-card', fallback_image: 'item-img-1-7.jpg', fallback_tag: 'Wearables', fallback_title: 'Smart Fitness Tracker Watch HR', fallback_price: '$79.00' %}
              {% render 'product-card', fallback_image: 'item-img-1-8.jpg', fallback_tag: 'Gaming', fallback_title: 'Pro Mechanical Gaming Keyboard', fallback_price: '$89.00' %}
              {% render 'product-card', fallback_image: 'item-img-1-10.jpg', fallback_tag: 'Lighting', fallback_title: 'RGB Sunset Glow Atmosphere Lamp', fallback_price: '$39.00' %}
            {% endif %}
          {% elsif showcase_collection != blank and showcase_collection.products_count > 0 %}
            {%- liquid
              assign rendered_count = 0
            -%}
            {% for product in showcase_collection.products %}
              {% if featured_product != blank and product.id == featured_product.id %}
                {% continue %}
              {% endif %}
              {% render 'product-card', product: product %}
              {%- liquid
                assign rendered_count = rendered_count | plus: 1
              -%}
              {% if rendered_count >= section.settings.products_limit %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% if rendered_count == 0 %}
              {% render 'product-card', fallback_image: 'item-img-1-6.jpg', fallback_tag: 'Audio', fallback_title: 'Noise Cancelling Wireless Headphones', fallback_price: '$149.00', fallback_compare_price: '$199.00' %}
              {% render 'product-card', fallback_image: 'item-img-1-7.jpg', fallback_tag: 'Wearables', fallback_title: 'Smart Fitness Tracker Watch HR', fallback_price: '$79.00' %}
              {% render 'product-card', fallback_image: 'item-img-1-8.jpg', fallback_tag: 'Gaming', fallback_title: 'Pro Mechanical Gaming Keyboard', fallback_price: '$89.00' %}
              {% render 'product-card', fallback_image: 'item-img-1-10.jpg', fallback_tag: 'Lighting', fallback_title: 'RGB Sunset Glow Atmosphere Lamp', fallback_price: '$39.00' %}
            {% endif %}
          {% else %}
            {% render 'product-card', fallback_image: 'item-img-1-6.jpg', fallback_tag: 'Audio', fallback_title: 'Noise Cancelling Wireless Headphones', fallback_price: '$149.00', fallback_compare_price: '$199.00' %}
            {% render 'product-card', fallback_image: 'item-img-1-7.jpg', fallback_tag: 'Wearables', fallback_title: 'Smart Fitness Tracker Watch HR', fallback_price: '$79.00' %}
            {% render 'product-card', fallback_image: 'item-img-1-8.jpg', fallback_tag: 'Gaming', fallback_title: 'Pro Mechanical Gaming Keyboard', fallback_price: '$89.00' %}
            {% render 'product-card', fallback_image: 'item-img-1-10.jpg', fallback_tag: 'Lighting', fallback_title: 'RGB Sunset Glow Atmosphere Lamp', fallback_price: '$39.00' %}
          {% endif %}
        </div>
      </div>

      <!-- Right Column: Main Hero Spotlight Product Card -->
      <div class="col-md-6">
        <div class="spotlight-product-card"{% if featured_block != blank %} {{ featured_block.shopify_attributes }}{% endif %}>
          
          <!-- Top Media Frame -->
          <div class="spotlight-media-box">
            {% if is_featured_available == false %}
              <span class="spotlight-badge badge-sold">SOLD OUT</span>
            {% elsif featured_product != blank and featured_product.compare_at_price > featured_product.price %}
              <span class="spotlight-badge badge-sale">SALE</span>
            {% else %}
              <span class="spotlight-badge badge-hot">#1 BESTSELLER</span>
            {% endif %}

            <a href="{{ featured_product.url | default: '#.' }}" class="spotlight-image-link">
              {% if featured_product != blank and featured_product.featured_image != blank %}
                {{ featured_product.featured_image | image_url: width: 900 | image_tag: alt: featured_product.title, loading: 'eager', class: 'spotlight-img', width: 500, height: 400 }}
              {% else %}
                <img src="{{ 'item-img-1-6.jpg' | asset_url }}" alt="Featured Product" class="spotlight-img" width="500" height="400">
              {% endif %}
            </a>
          </div>

          <!-- Bottom Product Details Area -->
          <div class="spotlight-details-box">
            <div>
              <span class="spotlight-cat-tag">
                {{ featured_product.type | default: featured_product.vendor | default: 'Featured Spotlight' | escape }}
              </span>

              <h3 class="spotlight-title">
                <a href="{{ featured_product.url | default: '#.' }}">
                  {{ featured_product.title | default: 'ProTech Ultra Series 9 Smart Watch' }}
                </a>
              </h3>

              <div class="spotlight-rating-row">
                <div class="stars">
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i>
                </div>
                <span class="reviews-text">4.9 / 5.0 (34 Reviews)</span>
              </div>
            </div>

            <div class="spotlight-price-stock-row">
              <div class="spotlight-price-wrap">
                {% if featured_product != blank %}
                  <span class="spotlight-price">{{ featured_product.price | money }}</span>
                  {% if featured_product.compare_at_price > featured_product.price and is_featured_available %}
                    <span class="spotlight-compare-price">{{ featured_product.compare_at_price | money }}</span>
                  {% endif %}
                {% else %}
                  <span class="spotlight-price">$249.00</span>
                  <span class="spotlight-compare-price">$299.00</span>
                {% endif %}
              </div>

              <div class="spotlight-stock-badge">
                {% if is_featured_available %}
                  <i class="fa-solid fa-circle-check text-success"></i>
                  <span>In Stock</span>
                {% else %}
                  <i class="fa-solid fa-circle-xmark text-danger"></i>
                  <span class="text-danger">Out of Stock</span>
                {% endif %}
              </div>
            </div>

            <div class="spotlight-cta-row">
              {% if featured_product != blank and featured_variant != blank %}
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="spotlight-cart-form">
                  <input type="hidden" name="id" value="{{ featured_variant.id }}">
                  <button type="submit" class="spotlight-add-btn" {% unless is_featured_available %}disabled{% endunless %}>
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span>
                      {% if is_featured_available %}
                        Add to Cart
                      {% else %}
                        Sold Out
                      {% endif %}
                    </span>
                  </button>
                </form>
              {% else %}
                <a href="{{ routes.all_products_collection_url }}" class="spotlight-add-btn">
                  <i class="fa-solid fa-bag-shopping"></i>
                  <span>Shop Catalog</span>
                </a>
              {% endif %}
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
  .creative-top-selling {
    padding: 40px 0;
    background: #f8fafc;
  }

  .creative-top-selling .container {
    width: 100% !important;
    max-width: 1240px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 15px !important;
    padding-right: 15px !important;
  }

  .top-selling-head {
    margin-bottom: 28px;
  }

  .section-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #10b981;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .section-main-heading {
    font-size: 28px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .top-selling-products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    height: 100%;
  }

  /* Right Spotlight Product Card */
  .spotlight-product-card {
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    transition: all 0.35s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .spotlight-product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.12);
    border-color: #10b981;
  }

  .spotlight-media-box {
    position: relative;
    width: 100%;
    height: 280px;
    background: #f8fafc;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .spotlight-image-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .spotlight-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .spotlight-product-card:hover .spotlight-img {
    transform: scale(1.08);
  }

  .spotlight-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 5px 12px;
    border-radius: 14px;
    text-transform: uppercase;
    z-index: 2;
  }

  .badge-hot {
    background: #0f172a;
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .badge-sale {
    background: #ef4444;
    color: #ffffff;
  }

  .badge-sold {
    background: #64748b;
    color: #ffffff;
  }

  /* Bottom Details Box */
  .spotlight-details-box {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    justify-content: space-between;
  }

  .spotlight-cat-tag {
    font-size: 11px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .spotlight-title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
    margin: 0;
  }

  .spotlight-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .spotlight-title a:hover {
    color: #10b981;
  }

  .spotlight-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spotlight-rating-row .stars {
    color: #f59e0b;
    font-size: 12px;
    display: flex;
    gap: 3px;
  }

  .reviews-text {
    font-size: 12px;
    color: #64748b;
    font-weight: 600;
  }

  .spotlight-price-stock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    margin-top: 4px;
    border-top: 1px solid #f1f5f9;
  }

  .spotlight-price-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .spotlight-price {
    font-size: 24px;
    font-weight: 900;
    color: #10b981;
  }

  .spotlight-compare-price {
    font-size: 15px;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .spotlight-stock-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #0f172a;
  }

  .spotlight-cta-row {
    margin-top: 10px;
  }

  .spotlight-cart-form {
    width: 100%;
  }

  .spotlight-add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    background: #10b981;
    color: #ffffff;
    padding: 12px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
  }

  .spotlight-add-btn:hover:not(:disabled) {
    background: #059669;
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4);
  }

  .spotlight-add-btn:disabled {
    background: #e2e8f0;
    color: #94a3b8;
    cursor: not-allowed;
    box-shadow: none;
  }

  @media (max-width: 991px) {
    .spotlight-product-card {
      margin-top: 24px;
    }
  }

  @media (max-width: 575px) {
    .top-selling-products-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    document.addEventListener('submit', function (e) {
      if (e.target && e.target.classList.contains('spotlight-cart-form')) {
        e.preventDefault();
        var form = e.target;
        var button = form.querySelector('.spotlight-add-btn');
        if (!button || button.disabled) return;

        var originalHtml = button.innerHTML;
        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Adding...</span>';
        button.disabled = true;

        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          body: new FormData(form)
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Add to cart failed');
            return response.json();
          })
          .then(function (data) {
            button.innerHTML = '<i class="fa-solid fa-check"></i> <span>Added to Cart!</span>';
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
            setTimeout(function () {
              button.innerHTML = originalHtml;
              button.disabled = false;
            }, 2500);
          })
          .catch(function (error) {
            button.innerHTML = originalHtml;
            button.disabled = false;
            form.submit();
          });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Top Selling Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Selling of the Week"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products collection"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "featured_media_limit",
      "label": "Featured media thumbnails",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "featured_panel",
      "name": "Featured panel",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Featured product override"
        },
        {
          "type": "range",
          "id": "featured_media_limit",
          "label": "Featured media thumbnails",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 4
        }
      ]
    },
    {
      "type": "manual_product",
      "name": "Manual product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback image asset",
          "default": "item-img-1-6.jpg"
        },
        {
          "type": "text",
          "id": "fallback_tag",
          "label": "Fallback tag",
          "default": "Tablets"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback title",
          "default": "Mp3 Sumergible Deportivo Slim Con 8GB"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "Fallback price",
          "default": "$350.00"
        },
        {
          "type": "text",
          "id": "fallback_compare_price",
          "label": "Fallback compare price",
          "default": "$200.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Selling Showcase"
    }
  ]
}
{% endschema %}
