{% doc %}
  Renders a modern theme-compatible blog post card with cover image on top and article content below.

  @param {object} [article] - Shopify article object
  @param {object} [block] - Section block object
  @param {string} [fallback_image] - Fallback image asset filename
  @param {string} [fallback_date] - Fallback date text
  @param {string} [fallback_comments] - Fallback comments text
  @param {string} [fallback_title] - Fallback title
  @param {string} [fallback_excerpt] - Fallback excerpt
  @param {string} [fallback_url] - Fallback URL
{% enddoc %}

{%- liquid
  assign post_image = blank
  assign post_date = fallback_date | default: '25 Dec, 2024'
  assign post_comments = fallback_comments | default: '12 Comments'
  assign post_title = fallback_title | default: 'Blog post title'
  assign post_excerpt = fallback_excerpt | default: 'Discover the latest breakthroughs in smart tech, living automation, and gadget reviews.'
  assign post_url = fallback_url | default: '#.'

  if article != blank
    assign post_image = article.image
    assign post_date = article.published_at | date: '%b %d, %Y'
    assign post_comments = article.comments_count | append: ' Comments'
    assign post_title = article.title
    assign post_excerpt = article.excerpt_or_content | strip_html | truncate: 120
    assign post_url = article.url
  elsif block != blank
    assign post_image = block.settings.image
    assign post_date = block.settings.date_text | default: post_date
    assign post_comments = block.settings.comments_text | default: post_comments
    assign post_title = block.settings.title | default: post_title
    assign post_excerpt = block.settings.excerpt | default: post_excerpt
    assign post_url = block.settings.link | default: post_url
  endif
-%}

<div class="col-md-4 col-sm-6" {% if block != blank %}{{ block.shopify_attributes }}{% endif %}>
  <div class="gadget-blog-card">
    
    <!-- Top Media Box (Full Width Cover Presentation) -->
    <div class="blog-card-media-box">
      <span class="blog-date-badge">
        <i class="fa-regular fa-calendar-check"></i>
        <span>{{ post_date }}</span>
      </span>

      <a href="{{ post_url }}" class="blog-media-link">
        {% if post_image != blank %}
          {{ post_image | image_url: width: 800 | image_tag: class: 'blog-post-img', alt: post_title, loading: 'lazy', width: 400, height: 260 }}
        {% elsif fallback_image != blank %}
          <img class="blog-post-img" src="{{ fallback_image | asset_url }}" alt="{{ post_title | escape }}" loading="lazy" width="400" height="260">
        {% else %}
          <div class="blog-placeholder-svg">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </a>
    </div>

    <!-- Bottom Content Box -->
    <div class="blog-card-content-box">
      <div class="blog-meta-row">
        <span class="blog-comments-tag">
          <i class="fa-regular fa-comment"></i>
          <span>{{ post_comments }}</span>
        </span>
        <span class="blog-author-tag">
          <i class="fa-regular fa-user"></i>
          <span>Tech Team</span>
        </span>
      </div>

      <h3 class="blog-post-title">
        <a href="{{ post_url }}">{{ post_title }}</a>
      </h3>

      {% if post_excerpt != blank %}
        <p class="blog-post-excerpt">{{ post_excerpt }}</p>
      {% endif %}

      <a href="{{ post_url }}" class="blog-readmore-btn">
        <span>Read Article</span>
        <i class="fa-solid fa-arrow-right-long"></i>
      </a>
    </div>

  </div>
</div>
