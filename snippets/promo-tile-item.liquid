{% doc %}
  Renders a promo tile block for the promo tile row section with product image on top and content below.

  @param {object} [block] - Section block object
  @param {string} [fallback_subtitle] - Subtitle text
  @param {string} [fallback_title] - Title text
  @param {string} [fallback_price] - Price text
  @param {string} [fallback_highlight] - Highlight text (sale variant)
  @param {string} [fallback_text] - Body text (sale variant)
  @param {string} [fallback_button_label] - Button label (sale variant)
  @param {string} [fallback_link] - CTA link
{% enddoc %}

{%- liquid
  assign subtitle = fallback_subtitle
  assign title = fallback_title
  assign price = fallback_price
  assign highlight = fallback_highlight
  assign body_text = fallback_text
  assign button_label = fallback_button_label
  assign tile_link = fallback_link | default: '#.'
  assign tile_background_image = blank

  if block != blank
    assign subtitle = block.settings.subtitle
    assign title = block.settings.title
    assign price = block.settings.price
    assign highlight = block.settings.highlight
    assign body_text = block.settings.body_text
    assign button_label = block.settings.button_label
    assign tile_link = block.settings.link | default: '#.'
    assign tile_background_image = block.settings.tile_background_image
  endif

  assign cta_label = button_label | default: 'Shop Now'
-%}

<div class="col-md-4 col-sm-6" {% if block != blank %}{{ block.shopify_attributes }}{% endif %}>
  <div class="gadget-promo-card">
    
    <!-- Top Image Container (Full Width Edge-to-Edge Cover) -->
    <div class="promo-card-image-box">
      {% if subtitle != blank %}
        <span class="promo-badge badge-tag">
          <i class="fa-solid fa-bolt"></i>
          <span>{{ subtitle }}</span>
        </span>
      {% elsif highlight != blank %}
        <span class="promo-badge badge-sale">
          <i class="fa-solid fa-fire"></i>
          <span>{{ highlight }}</span>
        </span>
      {% endif %}

      <a href="{{ tile_link }}" class="promo-image-link">
        {% if tile_background_image != blank %}
          {{ tile_background_image | image_url: width: 1000 | image_tag: alt: title, loading: 'lazy', class: 'promo-product-img', widths: '360,540,720,1000', width: 600, height: 400 }}
        {% else %}
          <img src="{{ 'item-img-1-1.jpg' | asset_url }}" alt="{{ title | escape }}" class="promo-product-img" width="600" height="400">
        {% endif %}
      </a>
      <div class="promo-img-bottom-shadow"></div>
    </div>

    <!-- Bottom Content Container (Below Image) -->
    <div class="promo-card-content-box">
      <div class="content-header">
        <h3 class="promo-card-title">
          <a href="{{ tile_link }}">{{ title }}</a>
        </h3>
        {% if body_text != blank %}
          <p class="promo-card-desc">{{ body_text }}</p>
        {% endif %}
      </div>

      <div class="content-footer-row">
        {% if price != blank %}
          <div class="promo-card-price">{{ price }}</div>
        {% endif %}
        <a href="{{ tile_link }}" class="promo-card-cta">
          <span>{{ cta_label }}</span>
          <i class="fa-solid fa-arrow-right-long"></i>
        </a>
      </div>
    </div>

  </div>
</div>
