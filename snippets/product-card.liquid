{% doc %}
  Renders a modern theme-compatible product card for collection grids and tab panels.

  @param {product} [product] - Shopify product object
  @param {block} [block] - Optional theme editor block for shopify attributes
  @param {string} [fallback_image] - Fallback asset filename
  @param {string} [fallback_tag] - Fallback product tag text
  @param {string} [fallback_title] - Fallback product title
  @param {string} [fallback_price] - Fallback price text
  @param {string} [fallback_compare_price] - Fallback compare-at price text
{% enddoc %}

{%- liquid
  assign card_title = fallback_title | default: 'Sample product'
  assign card_tag = fallback_tag | default: 'Featured'
  assign card_url = '#.'
  assign card_price = fallback_price | default: '$350.00'
  assign card_compare_price = fallback_compare_price
  assign card_image = blank
  assign is_available = true
  assign show_sale_tag = false
  assign show_new_tag = false
  assign show_sold_out_tag = false

  if product != blank
    assign card_title = product.title
    assign card_tag = product.type | default: product.vendor | default: fallback_tag | default: 'Featured'
    assign card_url = product.url
    assign card_price = product.price | money
    assign card_image = product.featured_image
    assign is_available = product.available

    if is_available == false
      assign show_sold_out_tag = true
    elsif product.compare_at_price > product.price
      assign card_compare_price = product.compare_at_price | money
      assign show_sale_tag = true
    elsif product.tags contains 'new'
      assign show_new_tag = true
    endif
  endif
-%}

<div class="gadget-product-card-wrap"{% if block != blank %} {{ block.shopify_attributes }}{% endif %}>
  <div class="gadget-product-card{% if is_available == false %} is-sold-out{% endif %}">
    
    <!-- Top Image Container -->
    <div class="card-media-box">
      {% if show_sold_out_tag %}
        <span class="card-badge badge-sold-out">SOLD OUT</span>
      {% elsif show_sale_tag %}
        <span class="card-badge badge-sale">SALE</span>
      {% elsif show_new_tag %}
        <span class="card-badge badge-new">NEW</span>
      {% endif %}

      <a href="{{ card_url }}" class="card-media-link">
        {% if card_image != blank %}
          {{ card_image | image_url: width: 720 | image_tag: alt: card_title, loading: 'lazy', class: 'card-img' }}
        {% elsif fallback_image != blank %}
          <img src="{{ fallback_image | asset_url }}" alt="{{ card_title | escape }}" loading="lazy" class="card-img" width="400" height="400">
        {% else %}
          <div class="card-placeholder-wrap">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </a>

      {% if is_available %}
        <a href="{{ card_url }}" class="card-quick-cart-btn" aria-label="View {{ card_title | escape }}">
          <i class="fa-solid fa-cart-shopping"></i>
        </a>
      {% endif %}
    </div>

    <!-- Bottom Content Container -->
    <div class="card-info-box">
      <div>
        <span class="card-category-tag">{{ card_tag | escape }}</span>
        <h4 class="card-item-title">
          <a href="{{ card_url }}">{{ card_title }}</a>
        </h4>

        <div class="card-rating-stars">
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
      </div>

      <div class="card-footer-price-row">
        <div class="card-price-wrap">
          <span class="price-current">{{ card_price }}</span>
          {% if card_compare_price != blank and is_available %}
            <span class="price-compare">{{ card_compare_price }}</span>
          {% endif %}
        </div>
        <a href="{{ card_url }}" class="card-action-btn{% unless is_available %} btn-disabled{% endunless %}">
          {% if is_available %}
            <i class="fa-solid fa-plus"></i>
          {% else %}
            <i class="fa-solid fa-ban"></i>
          {% endif %}
        </a>
      </div>
    </div>

  </div>
</div>
