{% doc %}
  Renders a featured category card with unobscured image presentation and quick sub-links.

  @param {object} [block] - Section block object
  @param {string} [fallback_image] - Fallback image asset filename
  @param {string} [fallback_title] - Fallback title
  @param {string} [fallback_link] - Fallback URL
{% enddoc %}

{%- liquid
  assign category_collection = blank
  assign category_title = fallback_title | default: 'Featured Category'
  assign category_url = fallback_link | default: '#.'

  if block != blank
    assign category_collection = block.settings.collection
    assign category_title = block.settings.title
    if category_title == blank and category_collection != blank
      assign category_title = category_collection.title
    endif
    if category_title == blank
      assign category_title = fallback_title | default: 'Featured Category'
    endif

    assign category_url = block.settings.link
    if category_url == blank and category_collection != blank
      assign category_url = category_collection.url
    endif
    if category_url == blank
      assign category_url = fallback_link | default: '#.'
    endif
  endif
-%}

<div class="col-md-4 col-sm-6" {% if block != blank %}{{ block.shopify_attributes }}{% endif %}>
  <div class="gadget-category-card">
    
    <!-- Left Details & Quick Links -->
    <div class="category-info-col">
      <h3 class="category-title">
        <a href="{{ category_url }}">{{ category_title | escape }}</a>
      </h3>

      <div class="category-links-list">
        {% if block != blank and block.settings.menu != blank and block.settings.menu.links.size > 0 %}
          {% for link in block.settings.menu.links limit: 3 %}
            <a href="{{ link.url }}" class="cat-sub-link">{{ link.title | escape }}</a>
          {% endfor %}
        {% elsif category_collection != blank and category_collection.products_count > 0 %}
          {% for product in category_collection.products limit: 3 %}
            <a href="{{ product.url }}" class="cat-sub-link">{{ product.title | escape }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ category_url }}" class="cat-sub-link">Best Sellers</a>
          <a href="{{ category_url }}" class="cat-sub-link">New Arrivals</a>
          <a href="{{ category_url }}" class="cat-sub-link">Top Deals</a>
        {% endif %}
      </div>

      <a href="{{ category_url }}" class="category-explore-btn">
        <span>Explore</span>
        <i class="fa-solid fa-arrow-right-long"></i>
      </a>
    </div>

    <!-- Right Media Container (Unobscured Category Photography) -->
    <div class="category-media-col">
      <a href="{{ category_url }}" class="category-img-frame">
        {% if block != blank and block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 400 | image_tag: alt: category_title, loading: 'lazy', class: 'cat-product-img', width: 140, height: 140 }}
        {% elsif category_collection != blank and category_collection.featured_image != blank %}
          {{ category_collection.featured_image | image_url: width: 400 | image_tag: alt: category_title, loading: 'lazy', class: 'cat-product-img', width: 140, height: 140 }}
        {% elsif fallback_image != blank %}
          <img src="{{ fallback_image | asset_url }}" alt="{{ category_title | escape }}" loading="lazy" class="cat-product-img" width="140" height="140">
        {% else %}
          <div class="cat-placeholder-svg">
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </a>
    </div>

  </div>
</div>
