<!-- All Collections Index Page -->
<section class="creative-collections-list">
  <div class="container">
    
    <!-- Top Breadcrumbs -->
    <nav class="collections-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <i class="fa-solid fa-chevron-right"></i>
      <span>Collections</span>
    </nav>

    <!-- Hero Card -->
    <header class="collections-hero-card">
      <div class="collections-hero-content">
        <span class="collections-badge-pill">
          <i class="fa-solid fa-boxes-stacked text-success"></i>
          <span>PRODUCT CATEGORIES</span>
        </span>
        <h1 class="collections-main-title">All Collections</h1>
        <p class="collections-hero-desc">
          Browse our curated store collections. Find the perfect smart gadgets, audio gear, wearable tech, and home automation solutions.
        </p>
      </div>
    </header>

    {% paginate collections by 16 %}
      {% if collections.size > 0 %}
        <div class="row collections-grid">
          {% for collection in collections %}
            {% assign collection_description = collection.description | strip_html | strip | truncatewords: 16 %}
            
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
              <article class="collection-item-card">
                
                <a href="{{ collection.url }}" class="collection-media-frame">
                  {% if collection.featured_image != blank %}
                    {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title, class: 'collection-img', width: 300, height: 300 }}
                  {% elsif collection.products.first != blank and collection.products.first.featured_image != blank %}
                    {{ collection.products.first.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title, class: 'collection-img', width: 300, height: 300 }}
                  {% else %}
                    <div class="collection-placeholder">
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}

                  <span class="collection-count-badge">
                    {{ collection.products_count }} {% if collection.products_count == 1 %}Item{% else %}Items{% endif %}
                  </span>
                </a>

                <div class="collection-card-body">
                  <h2 class="collection-title">
                    <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
                  </h2>

                  {% if collection_description != blank %}
                    <p class="collection-desc">{{ collection_description }}</p>
                  {% endif %}

                  <a href="{{ collection.url }}" class="collection-shop-btn">
                    <span>Shop Collection</span>
                    <i class="fa-solid fa-arrow-right-long"></i>
                  </a>
                </div>

              </article>
            </div>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="collections-pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}

      {% else %}
        <div class="collections-empty-card">
          <div class="empty-icon-circle">
            <i class="fa-solid fa-folder-open"></i>
          </div>
          <h3>No collections available</h3>
          <p>Please check back soon or browse all store products directly.</p>
          <a href="{{ routes.all_products_collection_url }}" class="empty-shop-btn">
            <span>View All Products</span>
            <i class="fa-solid fa-arrow-right-long"></i>
          </a>
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</section>

<style>
  .creative-collections-list {
    padding: 36px 0 64px 0;
    background: #f8fafc;
  }

  .creative-collections-list .container {
    width: 100% !important;
    max-width: 1240px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 15px !important;
    padding-right: 15px !important;
  }

  /* Breadcrumbs */
  .collections-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #64748b;
    margin-bottom: 24px;
  }

  .collections-breadcrumbs a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .collections-breadcrumbs a:hover {
    color: #10b981;
  }

  .collections-breadcrumbs i {
    font-size: 10px;
    color: #cbd5e1;
  }

  .collections-breadcrumbs span {
    color: #0f172a;
    font-weight: 700;
  }

  /* Hero Card */
  .collections-hero-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    padding: 32px 36px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    margin-bottom: 32px;
  }

  .collections-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #10b981;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .collections-main-title {
    font-size: 32px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 10px;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .collections-hero-desc {
    font-size: 14px;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    max-width: 760px;
  }

  /* Grid Card */
  .collection-item-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .collection-item-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
  }

  .collection-media-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f8fafc;
    overflow: hidden;
  }

  .collection-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collection-item-card:hover .collection-img {
    transform: scale(1.05);
  }

  .collection-count-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #10b981;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .collection-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .collection-title {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .collection-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .collection-title a:hover {
    color: #10b981;
  }

  .collection-desc {
    font-size: 13px;
    color: #64748b;
    line-height: 1.5;
    margin: 0 0 16px;
    flex: 1;
  }

  .collection-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    color: #10b981;
    text-decoration: none;
    margin-top: auto;
    transition: gap 0.2s ease;
  }

  .collection-shop-btn:hover {
    gap: 12px;
    color: #059669;
    text-decoration: none;
  }

  /* Empty State */
  .collections-empty-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px dashed #cbd5e1;
    padding: 60px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .empty-icon-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
  }

  .empty-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #10b981;
    color: #ffffff;
    padding: 10px 24px;
    border-radius: 25px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    margin-top: 10px;
  }

  @media (max-width: 575px) {
    .collections-hero-card {
      padding: 24px;
    }

    .collections-main-title {
      font-size: 26px;
    }
  }
</style>
